<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Authzed.Api.SpiceDB.Proto</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- tests/ and bridge/ are separate projects; keep their sources out of this assembly. -->
  <ItemGroup>
    <Compile Remove="tests/**;bridge/**" />
    <None Remove="tests/**;bridge/**" />
  </ItemGroup>

  <!--
    Dependency floors (root DESIGN.md, "Document the path off the legacy libraries"): exact
    lowest versions, not floating wildcards, so consumers inherit the minimum this assembly
    needs rather than whatever was newest at restore time. A NuGet version is a minimum, so
    consumers may still resolve newer ones. Grpc.Net.Client 2.80.0 and Google.Protobuf 3.34.1
    match the legacy Authzed.Net 1.6.0 package, so adopting the bridge raises nothing.
    Test frameworks live in tests/, never here.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.80.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpiceDB.Proto.Tests" />
  </ItemGroup>

</Project>
