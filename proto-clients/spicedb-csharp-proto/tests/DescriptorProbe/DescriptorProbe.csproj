<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A separate program whose first protobuf use is a descriptor, so the descriptor test sees a
    fresh process (a failed type initialiser stays failed for the life of a process).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SpiceDB.Proto.csproj" />
    <ProjectReference Include="../../bridge/Authzed.Net/Authzed.Net.csproj" />
  </ItemGroup>

</Project>
