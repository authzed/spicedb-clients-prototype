<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SpiceDB.Client</RootNamespace>
    <AssemblyName>SpiceDB.Client</AssemblyName>
    <Description>Idiomatic C# client for SpiceDB</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
    <!-- google.rpc.Status/ErrorInfo and Status.GetDetail<T>(). Referenced
         explicitly rather than relied on transitively, because Errors.cs reads
         SpiceDB's ErrorInfo detail directly. -->
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.*" />
    <!-- The RpcException <-> Google.Rpc.Status bridge: GetRpcStatus() and
         ToRpcException(). gRPC's own implementation of the
         grpc-status-details-bin trailer, used instead of reading and writing
         that trailer by hand. -->
    <PackageReference Include="Grpc.StatusProto" Version="2.67.*" />
  </ItemGroup>

  <!-- Reference the proto-generated client project -->
  <ItemGroup>
    <ProjectReference Include="../../proto-clients/spicedb-csharp-proto/SpiceDB.Proto.csproj" />
  </ItemGroup>

</Project>
