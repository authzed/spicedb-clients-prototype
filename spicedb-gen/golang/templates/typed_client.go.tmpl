// --- Check and Lookup Functions ---

func subjectRef(subject Subject) (rel.SubjectRef, error) {
	objectType, objectID, relation := subject.subjectRef()
	object, err := rel.NewObject(objectType, objectID)
	if err != nil {
		return rel.SubjectRef{}, err
	}
	return rel.NewSubject(object, relation)
}

func relationship(resourceType, resourceID, relation, subjectType, subjectID, subjectRelation string) (rel.Relationship, error) {
	resource, err := rel.NewObject(resourceType, resourceID)
	if err != nil {
		return rel.Relationship{}, err
	}
	object, err := rel.NewObject(subjectType, subjectID)
	if err != nil {
		return rel.Relationship{}, err
	}
	subject, err := rel.NewSubject(object, subjectRelation)
	if err != nil {
		return rel.Relationship{}, err
	}
	return rel.NewRelationship(resource, relation, subject)
}

func typedRelationship(resourceType, resourceID, relation string, subject Subject) TypedRelationship {
	sType, sID, sRel := subject.subjectRef()
	r, err := relationship(resourceType, resourceID, relation, sType, sID, sRel)
	if err != nil {
		return TypedRelationship{err: err}
	}
	if cName, cCtx := subject.caveatInfo(); cName != "" {
		r, err = r.WithCaveat(cName, cCtx)
		if err != nil {
			return TypedRelationship{err: err}
		}
	}
	if exp := subject.expirationTime(); exp != nil {
		r = r.WithExpiration(*exp)
	}
	return TypedRelationship{r: r}
}

// Check preserves the native result, including trace data. Options carry
// call-level context, tracing and the total operation budget.
func Check(ctx context.Context, tc *TypedClient, cs consistency.Strategy, perm Permission, subject Subject, opts ...client.CheckOption) (client.CheckResult, error) {
	check, err := perm.PermissionCheck(subject, cs)
	if err != nil {
		return client.CheckResult{}, err
	}
	return tc.Interface.Check(ctx, check, opts...)
}

// CheckByName checks a permission or relation named at runtime:
// CheckByName(ctx, tc, cs, "document", "readme", "view", subject). The names
// fail with ErrNotInSchema, and a subject whose type and relation cannot reach
// the permission (or a wildcard) with ErrSubjectNotAllowed, before any RPC.
func CheckByName(ctx context.Context, tc *TypedClient, cs consistency.Strategy, definition, id, permission string, subject Subject, opts ...client.CheckOption) (client.CheckResult, error) {
	perm, err := checkTarget(definition, id, permission, subject)
	if err != nil {
		return client.CheckResult{}, err
	}
	return Check(ctx, tc, cs, perm, subject, opts...)
}

// NamedCheck is one CheckBulkByName item, with names received at runtime.
type NamedCheck struct {
	Definition string
	ID         string
	Permission string
	Subject    Subject
}

// CheckBulkByName checks items named at runtime in one native bulk check;
// results are in input order. Every item is validated as in CheckByName
// before any RPC; a failure is a *client.BulkCheckError with its index.
func CheckBulkByName(ctx context.Context, tc *TypedClient, cs consistency.Strategy, checks []NamedCheck, opts ...client.CheckOption) ([]client.CheckResult, error) {
	typed := make([]TypedCheck, len(checks))
	for i, c := range checks {
		perm, err := checkTarget(c.Definition, c.ID, c.Permission, c.Subject)
		if err != nil {
			return nil, &client.BulkCheckError{Index: i, Err: err}
		}
		typed[i] = TypedCheck{Permission: perm, Subject: c.Subject}
	}
	return CheckBulk(ctx, tc, cs, typed, opts...)
}

// TypedCheck pairs a permission with the subject to check it for.
type TypedCheck struct {
	Permission Permission
	Subject    Subject
}

// ChecksFor checks each permission for the same subject.
func ChecksFor(subject Subject, perms ...Permission) []TypedCheck {
	checks := make([]TypedCheck, len(perms))
	for i, p := range perms {
		checks[i] = TypedCheck{Permission: p, Subject: subject}
	}
	return checks
}

// CheckBulk checks every item with the native bulk check: results are in
// input order, each carries its own chunk's revision, and per-item failures
// are *client.BulkCheckError values with the input index.
func CheckBulk(ctx context.Context, tc *TypedClient, cs consistency.Strategy, checks []TypedCheck, opts ...client.CheckOption) ([]client.CheckResult, error) {
	native := make([]client.PermissionCheck, len(checks))
	for i, c := range checks {
		check, err := c.Permission.PermissionCheck(c.Subject, cs)
		if err != nil {
			return nil, &client.BulkCheckError{Index: i, Err: err}
		}
		native[i] = check
	}
	return tc.Interface.CheckBulk(ctx, native, opts...)
}

func failedStream[T any](err error) iter.Seq2[T, error] {
	return func(yield func(T, error) bool) { var zero T; yield(zero, err) }
}

func emptyStream[T any]() iter.Seq2[T, error] {
	return func(func(T, error) bool) {}
}

// LookupResources preserves the subject's userset relation and native cancellation.
// For unconditional grants, pass client.WithLookupResourcesPermissionshipFilter(client.LookupHasPermissionOnly).
// By default, results include conditional permissions that require further caveat context.
func LookupResources(ctx context.Context, tc *TypedClient, cs consistency.Strategy, perm PermissionRef, subject Subject, opts ...client.LookupResourcesOption) iter.Seq2[client.LookupResource, error] {
	ref, err := subjectRef(subject)
	if err != nil {
		return failedStream[client.LookupResource](err)
	}
	return tc.Interface.LookupResources(ctx, client.LookupResourcesRequest{
		ResourceType: perm.resourceType, Permission: perm.permission,
		Subject: ref, Consistency: cs,
	}, opts...)
}

// LookupResourcesByName is LookupResources for a definition and a permission
// or relation name known only at runtime. Names the schema does not define
// fail the stream with an error wrapping ErrNotInSchema before any RPC. When
// the subject's type cannot reach the permission or relation in the schema,
// the stream is empty and no RPC is made, as SpiceDB would find nothing; a
// wildcard subject of a reachable type fails with ErrSubjectNotAllowed.
func LookupResourcesByName(ctx context.Context, tc *TypedClient, cs consistency.Strategy, definition, permission string, subject Subject, opts ...client.LookupResourcesOption) iter.Seq2[client.LookupResource, error] {
	ok, err := target(definition, permission, subject)
	if err != nil {
		return failedStream[client.LookupResource](err)
	}
	if !ok {
		return emptyStream[client.LookupResource]()
	}
	return LookupResources(ctx, tc, cs, PermissionRef{resourceType: definition, permission: permission}, subject, opts...)
}

// LookupSubjects preserves wildcard exclusions and native cancellation. A
// userset type sentinel selects that subject relation.
func LookupSubjects(ctx context.Context, tc *TypedClient, cs consistency.Strategy, perm Permission, subjectType Subject, opts ...client.LookupSubjectsOption) iter.Seq2[client.LookupSubject, error] {
	resource, err := rel.NewObject(perm.resourceType, perm.resourceID)
	if err != nil {
		return failedStream[client.LookupSubject](err)
	}
	sType, _, relation := subjectType.subjectRef()
	if relation != "" {
		opts = append([]client.LookupSubjectsOption{client.WithLookupSubjectsRelation(relation)}, opts...)
	}
	return tc.Interface.LookupSubjects(ctx, client.LookupSubjectsRequest{
		Resource: resource, Permission: perm.permission,
		SubjectType: sType, Consistency: cs,
	}, opts...)
}

// LookupSubjectsByName is LookupSubjects for names known only at runtime: a
// definition, resource id, permission or relation, a subject type and a
// subject relation ("" or "..." for direct subjects, or a relation such as
// "member" for team#member). Names the schema does not define fail the stream
// with an error wrapping ErrNotInSchema before any RPC. When the subject type
// and relation cannot reach the permission or relation in the schema, the
// stream is empty and no RPC is made.
func LookupSubjectsByName(ctx context.Context, tc *TypedClient, cs consistency.Strategy, definition, id, permission, subjectType, subjectRelation string, opts ...client.LookupSubjectsOption) iter.Seq2[client.LookupSubject, error] {
	if err := resolveByName(definition, permission); err != nil {
		return failedStream[client.LookupSubject](err)
	}
	sType, sRel := subjectType, subjectRelation
	if sRel == "..." {
		sRel = ""
	}
	sd, err := DefinitionByName(sType)
	if err != nil {
		return failedStream[client.LookupSubject](err)
	}
	if sRel != "" && !sd.has(sRel) {
		return failedStream[client.LookupSubject](fmt.Errorf("%w: %s has no relation or permission %q", ErrNotInSchema, sType, sRel))
	}
	if !reaches(definition, permission, schemaPosition(sType, sRel)) {
		return emptyStream[client.LookupSubject]()
	}
	resource, err := rel.NewObject(definition, id)
	if err != nil {
		return failedStream[client.LookupSubject](err)
	}
	if sRel != "" {
		opts = append([]client.LookupSubjectsOption{client.WithLookupSubjectsRelation(sRel)}, opts...)
	}
	return tc.Interface.LookupSubjects(ctx, client.LookupSubjectsRequest{
		Resource: resource, Permission: permission,
		SubjectType: sType, Consistency: cs,
	}, opts...)
}

// --- Write Methods ---

// Touch applies a collection atomically, preserving validation errors before any RPC.
func (tc *TypedClient) Touch(ctx context.Context, rels []TypedRelationship, opts ...client.WriteOption) (client.WriteResult, error) {
	var txn Txn
	for _, r := range rels {
		txn.Touch(r)
	}
	return tc.WriteTxn(ctx, &txn, opts...)
}

// Create applies a collection atomically, preserving validation errors before any RPC.
func (tc *TypedClient) Create(ctx context.Context, rels []TypedRelationship, opts ...client.WriteOption) (client.WriteResult, error) {
	var txn Txn
	for _, r := range rels {
		txn.Create(r)
	}
	return tc.WriteTxn(ctx, &txn, opts...)
}

// Delete applies a collection atomically, preserving validation errors before any RPC.
func (tc *TypedClient) Delete(ctx context.Context, rels []TypedRelationship, opts ...client.WriteOption) (client.WriteResult, error) {
	var txn Txn
	for _, r := range rels {
		txn.Delete(r)
	}
	return tc.WriteTxn(ctx, &txn, opts...)
}
