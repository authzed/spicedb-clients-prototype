    /**
     * Typed bulk check: results come back in input order, with the native per-chunk revisions,
     * options and per-item error behavior.
     */
    public List<CheckResult> checkBulk(Consistency c, List<TypedCheck> checks) {
      return checkBulk(c, checks, CheckOptions.builder().build());
    }

    public List<CheckResult> checkBulk(
        Consistency c, List<TypedCheck> checks, CheckOptions options) {
      var requests = new ArrayList<PermissionCheck>(checks.size());
      for (var check : checks) {
        requests.add(check.toPermissionCheck(c));
      }
      return client.checkBulk(requests, options);
    }

