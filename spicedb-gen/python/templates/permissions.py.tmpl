    subject team:eng#member.

    Raises NotInSchemaError for a definition the schema lacks or a relation
    or permission that no relation admits as a subject, and
    LocalValidationError (a ValueError) for an ID SpiceDB would reject.
    """
    definition_by_name(definition)
    cls = _SUBJECT_SETS.get(f"{definition}#{_require_name(relation, 'relation')}")
    if cls is None:
        raise NotInSchemaError(
            f"{definition}#{relation} is not a subject set in the schema"
        )
    _object(definition, object_id)
    return cls(object_id)


{{if .Wildcards}}_WILDCARDS: Final[dict[str, SchemaSubject]] = {
{{- range $w := .Wildcards}}
{{entry $w.Key (print $w.ClassName "()")}}
{{- end}}
}
{{else}}_WILDCARDS: Final[dict[str, SchemaSubject]] = {}
{{end}}

def parse_subject(text: str) -> SchemaSubject:
    """The typed subject for "type:id" or "type:id#relation" text ("#..." is
    direct): parse_subject("user:alice") == User("alice"),
    parse_subject("team:eng#member") == TeamMember("eng"), and "type:*" is
    the wildcard subject where the schema allows that wildcard.

    Raises LocalValidationError (a ValueError) for malformed text and
    NotInSchemaError for a type or relation the schema lacks, a relation or
    permission that no relation admits as a subject, or a wildcard the schema
    never allows.
    """
    ref = SubjectRef.parse(_require_name(text, "subject"))
    definition, object_id = ref.object.object_type, ref.object.object_id
    if ref.relation is not None:
        if object_id == "*":
            raise LocalValidationError(
                f"subject: invalid {text!r}; a wildcard has no relation"
            )
        return subject_set_by_name(definition, object_id, ref.relation)
    if object_id != "*":
        return object_by_name(definition, object_id)
    definition_by_name(definition)
    wildcard = _WILDCARDS.get(definition)
    if wildcard is None:
        raise NotInSchemaError(f"{definition}:* is not a subject in the schema")
    return wildcard


def _lookup_target(definition: str, resource_id: str, name: str) -> Permission:
    """The checkable permission or relation named on definition."""
    obj = definition_by_name(definition)(resource_id)
    try:
        return obj.permission_by_name(name)
    except NotInSchemaError:
        pass
    try:
        return obj.relation_by_name(name)
    except NotInSchemaError:
        pass
    raise NotInSchemaError(f"{definition} has no permission or relation {name!r}")


def _named_checks(
    checks: Iterable[tuple[str, str, str, Subject]],
) -> list[PermissionCheck]:
    """Native checks of (resource_type, resource_id, permission, subject)
    items named at runtime, each validated as _lookup_target and
    permission_check validate it."""
    if checks is None or isinstance(checks, (str, bytes)):
        raise LocalValidationError("checks must be an iterable of tuples")
    out: list[PermissionCheck] = []
    for i, item in enumerate(checks):
        entry: object = item
        if not isinstance(entry, (tuple, list)) or len(entry) != 4:
            raise LocalValidationError(
                f"checks[{i}] must be a (resource_type, resource_id, permission,"
                f" subject) tuple, got {type(entry).__name__}"
            )
        resource_type, resource_id, permission, s = item
        target = _lookup_target(resource_type, resource_id, permission)
        out.append(target.permission_check(s))
    return out


def _reaches(target: Permission, subject_type: str, subject_relation: str) -> bool:
    """Whether any subject of this type and relation can reach target."""
    admits = target._admits
    if admits is None:
        return False
    members = get_args(admits) or (admits,)
    return any(
        m._type == subject_type and m._relation == subject_relation for m in members
    )


{{tuple "_RELATIONS: Final[tuple[str, ...]]" .RelationKeys}}

{{tuple "_SUBJECT_RULES: Final[tuple[str, ...]]" .SubjectRules}}


def _subject_rule(r: Relationship) -> str:
    s = r.subject
    rule = s.object.object_type
    if s.object.object_id == "*":
        rule += ":*"
    if s.relation:
        rule += f"#{s.relation}"
    if r.caveat is not None:
        rule += f"[{r.caveat.name}]"
    if r.expiration is not None:
        rule += "[expiration]"
    return rule


def relationship_from_triple(
    resource: str,
    relation: str,
    subject: str,
    *,
    caveat: Caveat | None = None,
    expiration: datetime | None = None,
) -> TypedRelationship:
    """A schema-checked relationship from tuple text received at runtime:
    relationship_from_triple("document:readme", "viewer", "user:alice").

    resource is "type:id" and subject "type:id" or "type:id#relation"
    ("#..." is direct). The subject, with the caveat and expiration given,
    must be one the relation admits, exactly as SpiceDB checks a write.
    Raises LocalValidationError (a ValueError) for malformed text,
    NotInSchemaError for an unknown definition or relation, and
    SubjectNotAllowedError for a subject the relation does not admit.
    """
    for name, value in (
        ("resource", resource),
        ("relation", relation),
        ("subject", subject),
    ):
        _require_name(value, name)
    r = Relationship.from_triple(
        resource, relation, subject, caveat=caveat, expiration=expiration
    )
    for definition in (r.resource.object_type, r.subject.object.object_type):
        definition_by_name(definition)
    key = f"{r.resource.object_type}#{r.relation}"
    if key not in _RELATIONS:
        raise NotInSchemaError(
            f"{r.resource.object_type} has no relation {r.relation!r}"
        )
    if f"{key}@{_subject_rule(r)}" not in _SUBJECT_RULES:
        raise SubjectNotAllowedError(f"{key} does not admit {_subject_rule(r)}")
    return TypedRelationship(r)
