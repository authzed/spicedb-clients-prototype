    {{.Camel}}: "{{.Name}}",
{{- end}}
} as const);
/** Every definition name, in schema order, for startup verification. */
export const DefinitionNames: readonly DefinitionName[] = Object.freeze([{{range $i, $d := .Definitions}}{{if $i}}, {{end}}"{{$d.Name}}"{{end}}]);
/**
 * Any generated definition ref: the one type for code that handles an object
 * of any definition, such as the result of `definitionByName(name).ref(id)`.
 * Every member is also an {@link AnySubject}.
 */
export type AnyResourceRef = {{if .Definitions}}{{range $i, $d := .Definitions}}{{if $i}} | {{end}}{{$d.RefType}}{{end}}{{else}}never{{end}};

/** A schema definition found by name at runtime, e.g. from a policy expression or an admin tool. */
export interface DefinitionInfo<T extends DefinitionName = DefinitionName> {
    readonly name: T;
    /** Every relation name of the definition, in schema order. */
    readonly relationNames: readonly string[];
    /** Every permission name of the definition, in schema order. */
    readonly permissionNames: readonly string[];
    /** The definition's ref for `id`; its by-name permission, relation and relationship lookups validate against the schema. */
    ref(id: string): AnyResourceRef;
    /** The permission named `permission`, without a resource ID, for lookups; throws NotInSchemaError for names not in the schema. */
    permissionRef(permission: string): PermissionRef<T, string>;
}

function definitionInfo<T extends DefinitionName>(name: T, relationNames: readonly string[], permissionNames: readonly string[], ref: (id: string) => AnyResourceRef): DefinitionInfo<T> {
    return Object.freeze({
        name,
        relationNames,
        permissionNames,
        ref: (id: string) => ref(id),
        permissionRef: (permission: string) => {
            if (!permissionNames.includes(permission)) throw new NotInSchemaError(`${name} has no permission named "${permission}"`);
            return new PermissionRef(name, permission);
        },
    });
}

const definitionInfos: Readonly<Record<string, DefinitionInfo>> = Object.freeze({
{{- range .Definitions}}
    "{{.Name}}": definitionInfo("{{.Name}}", {{.PascalName}}RelationNames, {{.PascalName}}PermissionNames, {{.PascalName}}),
{{- end}}
});

/** The definition named `name`; throws NotInSchemaError for names not in the schema. */
export function definitionByName(name: string): DefinitionInfo {
    const info = Object.prototype.hasOwnProperty.call(definitionInfos, name) ? definitionInfos[name] : undefined;
    if (info === undefined) throw new NotInSchemaError(`schema has no definition named "${name}"`);
    return info;
}

/** The permission `permission` on definition `definition`, without a resource ID, for lookups; throws NotInSchemaError for names not in the schema. */
export function permissionRefByName(definition: string, permission: string): PermissionRef<DefinitionName, string> {
    return definitionByName(definition).permissionRef(permission);
}

/** Any generated subject set ref (`definition:id#relation`), as {@link subjectSetByName} returns it. */
export type AnySubjectSet = {{if .SubjectSets}}{{range $i, $s := .SubjectSets}}{{if $i}} | {{end}}{{$s.RefType}}{{end}}{{else}}never{{end}};

const subjectSetMakers: Readonly<Record<string, (id: string) => AnySubjectSet>> = Object.freeze({
{{- range .SubjectSets}}
    "{{.Position}}": (id: string) => {{.Maker}}(id),
{{- end}}
});

/**
 * The subject set `definition:id#relation` (such as `team:eng#member`) for
 * names received at runtime. Throws NotInSchemaError for an unknown
 * definition or relation, and for a relation or permission that no relation in
 * the schema admits as a subject.
 */
export function subjectSetByName(definition: string, id: string, relation: string): AnySubjectSet {
    const info = definitionByName(definition);
    const key = `${definition}#${relation}`;
    const make = Object.prototype.hasOwnProperty.call(subjectSetMakers, key) ? subjectSetMakers[key] : undefined;
    if (make !== undefined) {
        requireId(definition, id);
        return make(id);
    }
    if (!info.relationNames.includes(relation) && !info.permissionNames.includes(relation))
        throw new NotInSchemaError(`${definition} has no relation or permission named "${relation}"`);
    throw new NotInSchemaError(`${key} is not a subject anywhere in the schema`);
}

function requireId(type: string, id: string): void {
    if (!id) throw new InvalidArgumentError(`${type}: object ID must be nonempty`);
}

function objectText(text: string, what: string): { readonly type: string; readonly id: string } {
    const i = text.indexOf(":");
    if (i < 1 || i === text.length - 1) throw new InvalidArgumentError(`invalid ${what} (want type:id): ${text}`);
    return { type: text.slice(0, i), id: text.slice(i + 1) };
}

/**
 * The typed object for a definition name and ID received at runtime:
 * `objectByName("document", "readme")` is `Document("readme")`. Throws
 * NotInSchemaError for an unknown definition and InvalidArgumentError for an
 * empty ID.
 */
export function objectByName(definition: string, id: string): AnyResourceRef {
    const info = definitionByName(definition);
    requireId(definition, id);
    return info.ref(id);
}

/**
 * The typed object for `type:id` text: `parseObject("document:readme")` is
 * `Document("readme")`. Throws InvalidArgumentError for malformed text and
 * NotInSchemaError for an unknown definition.
 */
export function parseObject(text: string): AnyResourceRef {
    const { type, id } = objectText(text, "object reference");
    return objectByName(type, id);
}

/**
 * The typed subject for `type:id` or `type:id#relation` text (`#...` is
 * direct): `parseSubject("user:alice")` is `User("alice")`,
 * `parseSubject("team:eng#member")` is `Team("eng").member()`, and `type:*` is
 * the wildcard ref where the schema allows that wildcard. Throws
 * InvalidArgumentError for malformed text and NotInSchemaError for an unknown
 * definition or relation, a relation or permission that no relation admits as
 * a subject, or a wildcard the schema never allows.
 */
export function parseSubject(text: string): AnyResourceRef | AnySubjectSet{{range .Definitions}}{{if .WildcardType}} | {{.WildcardType}}{{end}}{{end}} {
    const hash = text.indexOf("#");
    const relation = hash < 0 ? undefined : text.slice(hash + 1);
    if (relation === "") throw new InvalidArgumentError(`invalid subject (empty relation): ${text}`);
    const { type, id } = objectText(hash < 0 ? text : text.slice(0, hash), "subject");
    if (relation !== undefined && relation !== "...") {
        if (id === "*") throw new InvalidArgumentError(`invalid subject (a wildcard has no relation): ${text}`);
        return subjectSetByName(type, id, relation);
    }
    if (id !== "*") return objectByName(type, id);
    definitionByName(type);
    switch (type) {
{{- range .Definitions}}{{if .WildcardType}}
        case "{{.Name}}":
            return {{.PascalName}}Wildcard();
{{- end}}{{end}}
    }
    throw new NotInSchemaError(`${type}:* is not a subject anywhere in the schema`);
}

/** `definition#relation@shape` for every subject shape every relation admits (see {@link relationshipFromTriple}). */
const subjectRules: ReadonlySet<string> = new Set([{{quoteList .SubjectRules}}]);

/** The caveat and expiration of a relationship built by {@link relationshipFromTriple}. */
export interface TripleOptions {
    readonly caveat?: { readonly name: string; readonly context?: JSONObject };
    readonly expiration?: Date;
}

/**
 * A schema-checked relationship from text received at runtime:
 * `relationshipFromTriple("document:readme", "viewer", "user:alice")`.
 * `resource` is `type:id` and `subject` is `type:id` or `type:id#relation`
 * (`#...` is direct). The subject, with the caveat and expiration given, must
 * be a shape the relation admits, exactly as SpiceDB checks a write. Throws
 * InvalidArgumentError for malformed text, NotInSchemaError for an unknown
 * definition or relation, and SubjectNotAllowedError for a subject the
 * relation does not admit.
 */
export function relationshipFromTriple(resource: string, relation: string, subject: string, options?: TripleOptions): TypedRelationship {
    const r = objectText(resource, "resource");
    const hash = subject.indexOf("#");
    const rawRelation = hash < 0 ? undefined : subject.slice(hash + 1);
    if (rawRelation === "") throw new InvalidArgumentError(`invalid subject (empty relation): ${subject}`);
    const subjectRelation = rawRelation === "..." ? undefined : rawRelation;
    const s = objectText(hash < 0 ? subject : subject.slice(0, hash), "subject");
    if (!relation) throw new InvalidArgumentError("relation must be nonempty");
    const info = definitionByName(r.type);
    definitionByName(s.type);
    if (!info.relationNames.includes(relation)) throw new NotInSchemaError(`${r.type} has no relation named "${relation}"`);
    const caveat = options?.caveat;
    const expiration = options?.expiration;
    const rule =
        s.type +
        (s.id === "*" ? ":*" : "") +
        (subjectRelation === undefined ? "" : `#${subjectRelation}`) +
        (caveat === undefined ? "" : `[${caveat.name}]`) +
        (expiration === undefined ? "" : "[expiration]");
    if (!subjectRules.has(`${r.type}#${relation}@${rule}`)) throw new SubjectNotAllowedError(`${r.type}#${relation} does not admit ${rule}`);
    return new TypedRelationship(() => ({
        resource: { objectType: r.type, objectId: r.id },
        relation,
        subject: { object: { objectType: s.type, objectId: s.id }, ...(subjectRelation === undefined ? {} : { relation: subjectRelation }) },
        ...(caveat === undefined ? {} : { caveat: { name: caveat.name, ...(caveat.context === undefined ? {} : { context: caveat.context }) } }),
        ...(expiration === undefined ? {} : { expiration }),
    }));
}

/** One {@link TypedClient.checkBulkByName} item, with names received at runtime. */
export interface NamedCheck {
    readonly definition: string;
    readonly id: string;
    readonly permission: string;
    readonly subject: AnySubject;
}

/** For each relation and permission, the subject positions ("type" or "type#relation") that can reach it. */
const reachingSubjects: Readonly<Record<string, readonly string[]>> = Object.freeze({
{{- range .Reaching}}
    "{{.Position}}": [{{quoteList .Subjects}}],
{{- end}}
});

function reaches(definition: string, name: string, subject: string): boolean {
    const key = `${definition}#${name}`;
    const subjects = Object.prototype.hasOwnProperty.call(reachingSubjects, key) ? reachingSubjects[key] : undefined;
    return subjects !== undefined && subjects.includes(subject);
}

function subjectPosition(subject: AnySubject): string {
    return subject._relation === undefined ? subject._type : `${subject._type}#${subject._relation}`;
}

/** Validates a definition and one of its relation or permission names. */
function resolveByName(definition: string, name: string): void {
    const info = definitionByName(definition);
    if (!info.relationNames.includes(name) && !info.permissionNames.includes(name))
        throw new NotInSchemaError(`${definition} has no permission or relation named "${name}"`);
}

async function* noResults<T>(): AsyncGenerator<T, void, undefined> {}

/**
 * Validates a by-name check or lookup: the names (NotInSchemaError), and a
 * wildcard subject of a reachable type (SubjectNotAllowedError). Returns
 * whether the subject's type and relation can reach the target.
 */
function reachable(definition: string, name: string, s: AnySubject): boolean {
    resolveByName(definition, name);
    definitionByName(s._type);
    if (!reaches(definition, name, subjectPosition(s))) return false;
    if (s._id === "*") throw new SubjectNotAllowedError(`${definition}#${name} cannot be checked or looked up for the wildcard ${subjectString(s)}`);
    return true;
}

/** The permission a by-name check resolves to; throws SubjectNotAllowedError for a subject that cannot reach it. */
function checkTarget(definition: string, id: string, name: string, s: AnySubject): Permission {
    if (!reachable(definition, name, s)) throw new SubjectNotAllowedError(`${definition}#${name} cannot be reached by ${subjectString(s)}`);
    return new Permission(definition, id, name);
}

// --- TypedClient ---
/**
 * Schema-typed operations over any {@link SpiceDBClientInterface}: a
 * `SpiceDBClient`, or an `InMemorySpiceDB` in tests.
 */
export class TypedClient {
    readonly client: SpiceDBClientInterface;

    constructor(client: SpiceDBClientInterface) {
        this.client = client;
    }

    static create(endpoint: string, token: string, options?: Omit<SpiceDBClientOptions, "endpoint" | "token">): TypedClient {
        return new TypedClient(createSpiceDBClient(endpoint, token, options));
    }

    // Check overloads: one per permission and per relation.
{{- range .CheckOverloads}}
    async check(c: Consistency, p: Permission<"{{.ResourceType}}", "{{.Name}}">, s: {{.SubjectUnion}}, options?: CheckOptions): Promise<CheckResult>;
{{- end}}
    async check(c: Consistency, p: Permission, s: AnySubject, options?: CheckOptions): Promise<CheckResult> {
        // A caveated subject's own context is item-level context: it wins per
        // key over options.context, the call-level default.
        return this.client.check(p.checkRequest(s, c), options);
    }

    /** Typed bulk check: forwards native options and preserves input order, per-chunk revisions and per-item errors. */
    async checkBulkTyped(c: Consistency, checks: readonly TypedCheck[], options?: CheckOptions): Promise<readonly CheckResult[]> {
        return this.client.checkBulk(
            checks.map((check) => check.permission.checkRequest(check.subject, c, check.context)),
            options,
        );
    }

    /** Writes a typed transaction atomically; throws its first deferred construction error before any RPC. */
    async writeTransaction(txn: TypedTransaction, options?: CallOptions): Promise<WriteResult> {
        return this.client.write(txn.build(), options);
    }

    // Writes accept a collection so cancellation and total budget options remain available.
    async touch(rels: readonly TypedRelationship[], options?: CallOptions): Promise<WriteResult> {
        return this.writeTransaction(rels.reduce((txn, r) => txn.touch(r), new TypedTransaction()), options);
    }

    async create(rels: readonly TypedRelationship[], options?: CallOptions): Promise<WriteResult> {
        return this.writeTransaction(rels.reduce((txn, r) => txn.create(r), new TypedTransaction()), options);
    }

    async delete(rels: readonly (TypedRelationship | RelationshipKey)[], options?: CallOptions): Promise<WriteResult> {
        return this.writeTransaction(rels.reduce((txn, r) => txn.delete(r), new TypedTransaction()), options);
    }

    close(): void {
        this.client.close();
    }

    // LookupResources overloads
{{- range .Lookups}}
    lookupResources(c: Consistency, p: PermissionRef<"{{.ResourceType}}", "{{.Name}}">, s: {{.SubjectUnion}}, options?: LookupResourcesOptions): AsyncIterableIterator<LookupResource>;
{{- end}}
    lookupResources(c: Consistency, p: PermissionRef, s: AnySubject, options?: LookupResourcesOptions): AsyncIterableIterator<LookupResource> {
        const requestOptions = requestFields(options);
        return this.client.lookupResources(
            { ...requestOptions, resourceType: p._type, permission: p._permission, subject: subjectRef(s), consistency: c },
            options,
        );
    }

    /**
     * Checks a permission or relation named at runtime, as a policy layer that
     * receives type names at runtime does. The names, and the subject's type,
     * must be in the schema (NotInSchemaError otherwise); a subject whose type
     * cannot reach the permission, or a wildcard, throws SubjectNotAllowedError
     * before any call.
     */
    async checkByName(c: Consistency, definition: string, id: string, permission: string, s: AnySubject, options?: CheckOptions): Promise<CheckResult> {
        return this.client.check(checkTarget(definition, id, permission, s).checkRequest(s, c), options);
    }

    /**
     * Checks items named at runtime in one native bulk check; results are in
     * input order. Every item is validated as in `checkByName` before any call.
     */
    async checkBulkByName(c: Consistency, checks: readonly NamedCheck[], options?: CheckOptions): Promise<readonly CheckResult[]> {
        const requests = checks.map((check) => checkTarget(check.definition, check.id, check.permission, check.subject).checkRequest(check.subject, c));
        return this.client.checkBulk(requests, options);
    }

    /**
     * Looks up resources by runtime definition and permission (or relation)
     * names, as a policy layer that receives type names at runtime does. Both
     * names, and the subject's type, must be in the schema (NotInSchemaError
     * otherwise). When the subject's type cannot reach the permission, the
     * result is empty and no call is made, as SpiceDB would find nothing; a
     * wildcard subject of a reachable type throws SubjectNotAllowedError.
     */
    lookupResourcesByName(c: Consistency, definition: string, permission: string, s: AnySubject, options?: LookupResourcesOptions): AsyncIterableIterator<LookupResource> {
        if (!reachable(definition, permission, s)) return noResults<LookupResource>();
        const requestOptions = requestFields(options);
        return this.client.lookupResources(
            { ...requestOptions, resourceType: definition, permission, subject: subjectRef(s), consistency: c },
            options,
        );
    }

    /**
     * Looks up subjects by runtime names: a definition, resource ID, permission
     * (or relation), subject type and optional subject relation (`"member"`
     * for `team#member`; omitted or `"..."` for direct subjects). Names not in
     * the schema throw NotInSchemaError before any call. When the subject type
     * and relation cannot reach the permission, the result is empty and no
     * call is made.
     */
    lookupSubjectsByName(
        c: Consistency,
        definition: string,
        id: string,
        permission: string,
        subjectType: string,
        subjectRelation?: string,
        options?: LookupSubjectsOptions,
    ): AsyncIterableIterator<LookupSubject> {
        resolveByName(definition, permission);
        const type = subjectType;
        const relation = subjectRelation === undefined || subjectRelation === "..." || subjectRelation === "" ? undefined : subjectRelation;
        const info = definitionByName(type);
        if (relation !== undefined && !info.relationNames.includes(relation) && !info.permissionNames.includes(relation))
            throw new NotInSchemaError(`${type} has no relation or permission named "${relation}"`);
        if (options?.subjectRelation !== undefined && options.subjectRelation !== relation)
            throw new InvalidArgumentError(`options.subjectRelation "${options.subjectRelation}" conflicts with subjectRelation "${subjectRelation ?? ""}"`);
        if (!reaches(definition, permission, relation === undefined ? type : `${type}#${relation}`)) return noResults<LookupSubject>();
        const requestOptions = requestFields(options);
        return this.client.lookupSubjects(
            {
                ...requestOptions,
                ...(relation === undefined ? {} : { subjectRelation: relation }),
                subjectType: type,
                permission,
                resource: { objectType: definition, objectId: id },
                consistency: c,
            },
            options,
        );
    }

    lookupSubjects(c: Consistency, p: Permission, subjectType: (id: string) => { _type: string }, options?: LookupSubjectsOptions): AsyncIterableIterator<LookupSubject> {
        const requestOptions = requestFields(options);
        return this.client.lookupSubjects(
            {
                ...requestOptions,
                subjectType: subjectType("")._type,
                permission: p._permission,
                resource: { objectType: p._type, objectId: p._id },
                consistency: c,
            },
            options,
        );
    }

    readRelationships(c: Consistency, filter: RelationshipFilter | { _type: string; _id?: string; _relation?: string }, options?: ReadRelationshipsOptions): AsyncIterableIterator<ReadRelationship> {
        const requestOptions = requestFields(options);
        return this.client.readRelationships(
            {
                ...requestOptions,
                filter: "resourceType" in filter ? filter : {
                    resourceType: filter._type,
                    ...(filter._id === undefined ? {} : { resourceId: filter._id }),
                    ...(filter._relation === undefined ? {} : { relation: filter._relation }),
                },
                consistency: c,
            },
            options,
        );
    }

    // Native capabilities retain their full typed signatures and stream ownership.
    ready(...args: Parameters<SpiceDBClientInterface["ready"]>): ReturnType<SpiceDBClientInterface["ready"]> {
        return this.client.ready(...args);
    }
    raw(...args: Parameters<SpiceDBClientInterface["raw"]>): ReturnType<SpiceDBClientInterface["raw"]> {
        return this.client.raw(...args);
    }
    checkBulk(...args: Parameters<SpiceDBClientInterface["checkBulk"]>): ReturnType<SpiceDBClientInterface["checkBulk"]> {
        return this.client.checkBulk(...args);
    }
    write(...args: Parameters<SpiceDBClientInterface["write"]>): ReturnType<SpiceDBClientInterface["write"]> {
        return this.client.write(...args);
    }
    deleteRelationships(...args: Parameters<SpiceDBClientInterface["deleteRelationships"]>): ReturnType<SpiceDBClientInterface["deleteRelationships"]> {
        return this.client.deleteRelationships(...args);
    }
    deleteAllRelationshipsNonAtomic(...args: Parameters<SpiceDBClientInterface["deleteAllRelationshipsNonAtomic"]>): ReturnType<SpiceDBClientInterface["deleteAllRelationshipsNonAtomic"]> {
        return this.client.deleteAllRelationshipsNonAtomic(...args);
    }
    expandPermissionTree(...args: Parameters<SpiceDBClientInterface["expandPermissionTree"]>): ReturnType<SpiceDBClientInterface["expandPermissionTree"]> {
        return this.client.expandPermissionTree(...args);
    }
    importRelationships(...args: Parameters<SpiceDBClientInterface["importRelationships"]>): ReturnType<SpiceDBClientInterface["importRelationships"]> {
        return this.client.importRelationships(...args);
    }
    exportRelationships(...args: Parameters<SpiceDBClientInterface["exportRelationships"]>): ReturnType<SpiceDBClientInterface["exportRelationships"]> {
        return this.client.exportRelationships(...args);
    }
    readSchema(...args: Parameters<SpiceDBClientInterface["readSchema"]>): ReturnType<SpiceDBClientInterface["readSchema"]> {
        return this.client.readSchema(...args);
    }
    writeSchema(...args: Parameters<SpiceDBClientInterface["writeSchema"]>): ReturnType<SpiceDBClientInterface["writeSchema"]> {
        return this.client.writeSchema(...args);
    }
    reflectSchema(...args: Parameters<SpiceDBClientInterface["reflectSchema"]>): ReturnType<SpiceDBClientInterface["reflectSchema"]> {
        return this.client.reflectSchema(...args);
    }
    computablePermissions(...args: Parameters<SpiceDBClientInterface["computablePermissions"]>): ReturnType<SpiceDBClientInterface["computablePermissions"]> {
        return this.client.computablePermissions(...args);
    }
    dependentRelations(...args: Parameters<SpiceDBClientInterface["dependentRelations"]>): ReturnType<SpiceDBClientInterface["dependentRelations"]> {
        return this.client.dependentRelations(...args);
    }
    diffSchema(...args: Parameters<SpiceDBClientInterface["diffSchema"]>): ReturnType<SpiceDBClientInterface["diffSchema"]> {
        return this.client.diffSchema(...args);
    }
    experimentalRegisterRelationshipCounter(...args: Parameters<SpiceDBClientInterface["experimentalRegisterRelationshipCounter"]>): ReturnType<SpiceDBClientInterface["experimentalRegisterRelationshipCounter"]> {
        return this.client.experimentalRegisterRelationshipCounter(...args);
    }
    experimentalCountRelationships(...args: Parameters<SpiceDBClientInterface["experimentalCountRelationships"]>): ReturnType<SpiceDBClientInterface["experimentalCountRelationships"]> {
        return this.client.experimentalCountRelationships(...args);
    }
    experimentalUnregisterRelationshipCounter(...args: Parameters<SpiceDBClientInterface["experimentalUnregisterRelationshipCounter"]>): ReturnType<SpiceDBClientInterface["experimentalUnregisterRelationshipCounter"]> {
        return this.client.experimentalUnregisterRelationshipCounter(...args);
    }
    watch(...args: Parameters<SpiceDBClientInterface["watch"]>): ReturnType<SpiceDBClientInterface["watch"]> {
        return this.client.watch(...args);
    }
    experimentalCountRelationshipsByFilter(...args: Parameters<SpiceDBClientInterface["experimentalCountRelationshipsByFilter"]>): ReturnType<SpiceDBClientInterface["experimentalCountRelationshipsByFilter"]> {
        return this.client.experimentalCountRelationshipsByFilter(...args);
    }
    experimentalWatchPermissionSets(...args: Parameters<SpiceDBClientInterface["experimentalWatchPermissionSets"]>): ReturnType<SpiceDBClientInterface["experimentalWatchPermissionSets"]> {
        return this.client.experimentalWatchPermissionSets(...args);
    }
    experimentalLookupPermissionSets(...args: Parameters<SpiceDBClientInterface["experimentalLookupPermissionSets"]>): ReturnType<SpiceDBClientInterface["experimentalLookupPermissionSets"]> {
        return this.client.experimentalLookupPermissionSets(...args);
    }
    experimentalDownloadPermissionSets(...args: Parameters<SpiceDBClientInterface["experimentalDownloadPermissionSets"]>): ReturnType<SpiceDBClientInterface["experimentalDownloadPermissionSets"]> {
        return this.client.experimentalDownloadPermissionSets(...args);
    }
    experimentalRoaringLookupResources(...args: Parameters<SpiceDBClientInterface["experimentalRoaringLookupResources"]>): ReturnType<SpiceDBClientInterface["experimentalRoaringLookupResources"]> {
        return this.client.experimentalRoaringLookupResources(...args);
    }
}
